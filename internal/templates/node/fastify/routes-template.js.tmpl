/**
 * {{.ServiceName}} routes (Fastify)
 * Generated by bffgen from bffgen.config.json. `bffgen generate` overwrites this file.
 */

{{if .AnyRoles -}}
const { authorize } = require('../middleware/authorize');
{{end -}}
const { createUpstream } = require('../utils/upstream');

const upstream = createUpstream('{{js .ServiceName}}', {
  envKey: '{{.EnvKey}}',
  baseURL: '{{js .BaseURL}}',
  timeout: {{.Timeout}},
  retries: {{.Retries}},
  circuitBreaker: { enabled: {{.BreakerEnabled}}, failureThreshold: {{.FailureThreshold}}, resetTimeout: {{.ResetTimeout}} }
});

async function {{.FunctionName}}(fastify) {
{{- range .Endpoints}}
  // {{.Method}} {{.Path}} -> {{.Method}} {{.BackendPath}}
  fastify.{{.MethodLower}}('{{js .Path}}', {
{{- if .RequiresAuth}}
    onRequest: [fastify.authenticate],
{{- end}}
{{- if .Roles}}
    preHandler: [authorize([{{range $i, $r := .Roles}}{{if $i}}, {{end}}'{{js $r}}'{{end}}])],
{{- end}}
    schema: {
      description: '{{.Method}} {{js .Path}}',
      tags: ['{{js $.ServiceName}}']
    }
  }, (request, reply) => upstream.proxy(request, reply, { method: '{{.Method}}', path: '{{js .BackendPath}}' }));
{{end}}}

module.exports = {{.FunctionName}};
