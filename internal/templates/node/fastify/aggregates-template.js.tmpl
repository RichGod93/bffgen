/**
 * Aggregate routes (Fastify)
 * Generated by bffgen from the "aggregates" in bffgen.config.json. `bffgen generate` overwrites this file.
 *
 * Each route calls its sources in parallel and answers { data, sources }; a failed source that
 * is not required leaves its data null. See aggregate() in src/utils/upstream.js.
 */

{{if .AnyAuth -}}
const { authenticate } = require('../middleware/auth');
{{end -}}
{{if .AnyRoles -}}
const { authorize } = require('../middleware/authorize');
{{end -}}
const { createUpstream, aggregate } = require('../utils/upstream');
{{range .Backends}}
const {{.Var}} = createUpstream('{{js .ServiceName}}', {
  envKey: '{{.EnvKey}}',
  baseURL: '{{js .BaseURL}}',
  timeout: {{.Timeout}},
  retries: {{.Retries}},
  circuitBreaker: { enabled: {{.BreakerEnabled}}, failureThreshold: {{.FailureThreshold}}, resetTimeout: {{.ResetTimeout}} }
});
{{- end}}

async function aggregateRoutes(fastify) {
{{- range .Aggregates}}
  // GET {{.Path}}{{with .Name}} ({{.}}){{end}}
  fastify.get('{{js .Path}}', {
{{- if .RequiresAuth}}
    onRequest: [authenticate],
{{- end}}
{{- if .Roles}}
    preHandler: [authorize({{.RolesJS}})],
{{- end}}
    schema: {
      description: 'Aggregate: GET {{js .Path}}',
      tags: ['aggregates']
    }
  }, (request, reply) => aggregate(request, reply, [
{{- range .Sources}}
    { as: '{{js .As}}', upstream: {{.Var}}, path: '{{.Path}}', required: {{.Required}} },
{{- end}}
  ]));
{{end}}}

module.exports = aggregateRoutes;
