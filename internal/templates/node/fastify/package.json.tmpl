{
  "name": "{{.ProjectName}}",
  "version": "1.0.0",
  "description": "Backend-for-Frontend service generated by bffgen",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "dev:watch": "nodemon --watch src --watch .env src/index.js",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "test:integration": "jest --testPathPattern=integration",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write 'src/**/*.js'",
    "format:check": "prettier --check 'src/**/*.js'",
    "validate": "npm run lint && npm run format:check && npm test",
    "test:aggregation": "jest --testPathPattern=aggregation",
    "test:utils": "jest --testPathPattern=utils",
    "cache:clear": "node scripts/clear-cache.js"
  },
  "keywords": ["bff", "backend-for-frontend", "api", "fastify"],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@fastify/cors": "{{GetVersion "@fastify/cors"}}",
    "@fastify/helmet": "{{GetVersion "@fastify/helmet"}}",
    "@fastify/rate-limit": "{{GetVersion "@fastify/rate-limit"}}",
    "fastify": "{{GetVersion "fastify"}}",
    "@fastify/jwt": "{{GetVersion "@fastify/jwt"}}",
    "@fastify/cookie": "{{GetVersion "@fastify/cookie"}}",
    "@fastify/env": "{{GetVersion "@fastify/env"}}",
    "@fastify/swagger": "{{GetVersion "@fastify/swagger"}}",
    "@fastify/swagger-ui": "{{GetVersion "@fastify/swagger-ui"}}",
    "fastify-plugin": "{{GetVersion "fastify-plugin"}}",
    "pino": "{{GetVersion "pino"}}",
    "pino-pretty": "{{GetVersion "pino-pretty"}}",
    "dotenv": "{{GetVersion "dotenv"}}"
  },
  "optionalDependencies": {
    "redis": "{{GetVersion "redis"}}"
  },
  "devDependencies": {
    "nodemon": "{{GetVersion "nodemon"}}",
    "jest": "{{GetVersion "jest"}}",
    "nock": "{{GetVersion "nock"}}",
    "eslint": "{{GetVersion "eslint"}}",
    "prettier": "{{GetVersion "prettier"}}"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}

