{
  "name": "{{.ProjectName}}",
  "version": "1.0.0",
  "description": "Backend-for-Frontend service generated by bffgen",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "dev:watch": "nodemon --watch src --watch .env src/index.js",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "test:integration": "jest --testPathPattern=integration",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write 'src/**/*.js'",
    "format:check": "prettier --check 'src/**/*.js'",
    "validate": "npm run lint && npm run format:check && npm test",
    "test:aggregation": "jest --testPathPattern=aggregation",
    "test:utils": "jest --testPathPattern=utils",
    "cache:clear": "node scripts/clear-cache.js"
  },
  "keywords": ["bff", "backend-for-frontend", "api", "express"],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "express": "{{GetVersion "express"}}",
    "cors": "{{GetVersion "cors"}}",
    "helmet": "{{GetVersion "helmet"}}",
    "express-rate-limit": "{{GetVersion "express-rate-limit"}}",
    "jsonwebtoken": "{{GetVersion "jsonwebtoken"}}",
    "cookie-parser": "{{GetVersion "cookie-parser"}}",
    "express-validator": "{{GetVersion "express-validator"}}",
    "dotenv": "{{GetVersion "dotenv"}}",
    "winston": "{{GetVersion "winston"}}",
    "morgan": "{{GetVersion "morgan"}}",
    "swagger-ui-express": "{{GetVersion "swagger-ui-express"}}",
    "swagger-jsdoc": "{{GetVersion "swagger-jsdoc"}}"
  },
  "optionalDependencies": {
    "redis": "{{GetVersion "redis"}}"
  },
  "devDependencies": {
    "nodemon": "{{GetVersion "nodemon"}}",
    "jest": "{{GetVersion "jest"}}",
    "@babel/plugin-transform-modules-commonjs": "{{GetVersion "@babel/plugin-transform-modules-commonjs"}}",
    "supertest": "{{GetVersion "supertest"}}",
    "nock": "{{GetVersion "nock"}}",
    "eslint": "{{GetVersion "eslint"}}",
    "@eslint/js": "{{GetVersion "@eslint/js"}}",
    "globals": "{{GetVersion "globals"}}",
    "prettier": "{{GetVersion "prettier"}}"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}

