const express = require('express');
{{- if .AnyAuth}}
const { authenticate } = require('../middleware/auth');
{{- end}}
const { createUpstream } = require('../utils/upstream');

const router = express.Router();
const upstream = createUpstream('{{js .ServiceName}}', {
  envKey: '{{.EnvKey}}',
  baseURL: '{{js .BaseURL}}'
});
{{range .Endpoints}}
// {{.Method}} {{.Path}} -> {{.Method}} {{.BackendPath}}
router.{{.MethodLower}}('{{js .Path}}', {{if .RequiresAuth}}authenticate, {{end}}(req, res, next) =>
  upstream.proxy(req, res, { method: '{{.Method}}', path: '{{js .BackendPath}}' }).catch(next));
{{end}}
module.exports = router;
