    if (!req.user) {
      res.header('WWW-Authenticate', 'Bearer');
      res.status(401).send({ error: 'Unauthorized', message: 'Authentication required', code: 'UNAUTHENTICATED' });
      return;
    }
    if (!hasAnyRole(req.user, roles)) {
      res.status(403).send({ error: 'Forbidden', message: 'Insufficient role', code: 'INSUFFICIENT_ROLE' });
      return;
    }
    next();
  };
