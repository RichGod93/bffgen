}

/**
 * The roles in a verified JWT payload, as an array of strings
 * @param {Object} user - decoded JWT payload
 * @returns {string[]}
 */
function userRoles(user) {
  if (user === null || typeof user !== 'object') {
    return [];
  }
  const claim = process.env.JWT_ROLES_CLAIM;
  const value = claim ? claimValue(user, claim) : (user.roles !== undefined ? user.roles : user.role);
  if (Array.isArray(value)) {
    return value.filter((role) => typeof role === 'string' && role !== '');
  }
  if (typeof value === 'string') {
    return value.split(/[\s,]+/).filter(Boolean);
  }
  return [];
}

/**
 * Whether user has at least one of roles
 * @param {Object} user - decoded JWT payload
 * @param {string[]} roles - accepted roles
 * @returns {boolean}
 */
function hasAnyRole(user, roles) {
  const granted = userRoles(user);
  return roles.some((role) => granted.includes(role));
}

/**
 * Middleware / preHandler that requires one of roles
 * @param {string[]} roles - accepted roles
