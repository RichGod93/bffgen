/**
 * Role-based access control for generated routes
 * Managed by bffgen (bffgen:runtime 1). `bffgen generate` replaces this file when
 * bffgen ships a newer version and keeps your previous copy as authorize.js.bak.
 *
 * Endpoints with "roles": ["admin", ...] in bffgen.config.json get authorize([...]) after
 * authentication. Works as Express middleware (req, res, next) and as a Fastify preHandler
 * hook (request, reply, done). The user needs at least one of the listed roles:
 *   401 Unauthorized  UNAUTHENTICATED    no authenticated user on the request (WWW-Authenticate: Bearer)
 *   403 Forbidden     INSUFFICIENT_ROLE  authenticated, but none of the required roles
 * with the body { error, message, code }. The required roles are not revealed.
 *
 * Roles are read from the verified JWT payload (req.user / request.user):
 *   - JWT_ROLES_CLAIM unset: the "roles" claim, else the "role" claim
 *   - JWT_ROLES_CLAIM set: that claim, e.g. "cognito:groups", or a dotted path into nested
 *     claims, e.g. "realm_access.roles" (Keycloak). A claim whose name contains dots, such
 *     as "https://example.com/roles", is matched by its full name first.
 * A claim may be an array of strings or one string of space- or comma-separated roles.
 */

function claimValue(user, claim) {
  if (Object.prototype.hasOwnProperty.call(user, claim)) {
    return user[claim];
  }
  return claim.split('.').reduce(
    (value, key) => (value !== null && typeof value === 'object' ? value[key] : undefined),
    user
