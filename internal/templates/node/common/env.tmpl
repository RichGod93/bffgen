# Environment Configuration for {{.ProjectName}}

# Server Configuration
NODE_ENV=development
PORT=8080
HOST=0.0.0.0

# CORS Configuration
# Comma-separated list of allowed origins
CORS_ORIGINS={{.CORSOriginsEnv}}

# Rate Limiting
RATE_LIMIT=100

# Logging
LOG_LEVEL=info

# Security
# JWT_SECRET signs and verifies HS256 tokens (src/middleware/auth.js). With NODE_ENV=production the
# server refuses to start unless it is set to a random value of at least 32 characters, e.g. the
# output of `openssl rand -base64 48`; this development placeholder is refused there.
JWT_SECRET=change-this-secret-in-production-use-at-least-32-characters
JWT_EXPIRES_IN=24h
# POST /api/auth/login is a demo that signs a token for any credentials. It is served unless
# NODE_ENV=production; set AUTH_DEMO_LOGIN=true or false to decide explicitly.
# AUTH_DEMO_LOGIN=
# COOKIE_SECRET is only needed if you use signed cookies
COOKIE_SECRET=

# Encryption (for sensitive data)
ENCRYPTION_KEY=

# Redis (optional - for rate limiting, sessions, caching)
REDIS_URL=redis://localhost:6379

# Backend Services
{{.BackendServicesEnv}}

# Database (if applicable)
# DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# External APIs
# API_KEY=your-api-key-here
# API_SECRET=your-api-secret-here

# Feature Flags
# ENABLE_FEATURE_X=true
# ENABLE_FEATURE_Y=false

# Monitoring & Observability (optional)
# SENTRY_DSN=
# NEW_RELIC_LICENSE_KEY=
# DATADOG_API_KEY=

