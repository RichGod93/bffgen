/**
 * Upstream proxy runtime
 * Managed by bffgen (bffgen:runtime 1). `bffgen generate` replaces this file when
 * bffgen ships a newer version and keeps your previous copy as upstream.js.bak.
 *
 * Generated routes call createUpstream(...).proxy(req, res, route) to forward a
 * request to a backend service. Works with Express (req, res) and Fastify (request, reply).
 */

// Request headers passed on to backends. Hop-by-hop and host headers are never forwarded.
const FORWARDED_REQUEST_HEADERS = [
  'accept',
  'accept-language',
  'authorization',
  'if-modified-since',
  'if-none-match'
];

// Backend response headers passed back to clients. content-length and content-encoding are
// left to the framework because fetch has already decoded the body.
const FORWARDED_RESPONSE_HEADERS = [
  'cache-control',
  'content-type',
  'etag',
  'last-modified',
  'location'
];

const NO_BODY_STATUSES = new Set([204, 205, 304]);

const upstreams = new Map();

/**
 * Substitute :params in a backend path template, URL-encoding each value.
 * buildPath('/users/:id', { id: '42' }) -> '/users/42'
 */
function buildPath(template, params = {}) {
  return template.replace(/:([A-Za-z_$][\w$]*)/g, (match, name) => {
    const value = params[name];
    if (value === undefined || value === null || value === '') {
      throw new Error(`Missing path parameter "${name}" for backend path ${template}`);
    }
    return encodeURIComponent(value);
  });
}

/**
 * Raw query string (including the leading '?') of a request URL, or ''.
 * Kept verbatim so repeated keys and their order reach the backend unchanged.
 */
function queryStringOf(url = '') {
  const index = url.indexOf('?');
  return index === -1 ? '' : url.slice(index);
}

function requestHeaders(req) {
  const headers = {};
  for (const name of FORWARDED_REQUEST_HEADERS) {
    if (req.headers[name] !== undefined) {
      headers[name] = req.headers[name];
    }
  }
  // Propagate the caller's correlation id; fall back to the framework's request id
  const requestId = req.headers['x-request-id'] || req.id;
  if (requestId) {
    headers['x-request-id'] = String(requestId);
  }
  return headers;
}

/**
 * Serialize a parsed request body for forwarding. Returns undefined when there is none.
 */
function requestBody(req, headers) {
  const body = req.body;
  if (body === undefined || body === null) {
    return undefined;
  }
  if (typeof body === 'string' || Buffer.isBuffer(body)) {
    if (req.headers['content-type']) {
      headers['content-type'] = req.headers['content-type'];
    }
    return body;
  }
  headers['content-type'] = 'application/json';
  return JSON.stringify(body);
}

/**
 * Send a backend response to the client. `res` is an Express response or a Fastify reply;
 * both support status(), header() and send().
 */
function sendResponse(res, { status, headers, body }, method) {
  res.status(status);
  for (const name of FORWARDED_RESPONSE_HEADERS) {
    const value = headers.get(name);
    if (value !== null) {
      res.header(name, value);
    }
  }
  if (method === 'HEAD' || NO_BODY_STATUSES.has(status) || body.length === 0) {
    return res.send();
  }
  return res.send(body);
}

class Upstream {
  /**
   * @param {string} name - Backend name from bffgen.config.json
   * @param {Object} options
   * @param {string} options.envKey - Prefix of the environment variables for this backend
   * @param {string} options.baseURL - Default base URL; <envKey>_URL overrides it
   */
  constructor(name, { envKey, baseURL }) {
    this.name = name;
    this.baseURL = (process.env[`${envKey}_URL`] || process.env[`${envKey}_SERVICE_URL`] || baseURL).replace(/\/+$/, '');
  }

  /**
   * Forward the current request to the backend and send its response.
   * @param {Object} req - Express request or Fastify request
   * @param {Object} res - Express response or Fastify reply
   * @param {Object} route - { method, path } of the backend endpoint; path may contain :params
   */
  async proxy(req, res, route) {
    // Express and Fastify answer HEAD with the GET handler; keep it a HEAD upstream
    const method = req.method === 'HEAD' ? 'HEAD' : route.method;
    const url = this.baseURL + buildPath(route.path, req.params) + queryStringOf(req.originalUrl || req.url);
    const headers = requestHeaders(req);
    const body = method === 'GET' || method === 'HEAD' ? undefined : requestBody(req, headers);

    const response = await fetch(url, { method, headers, body });
    const result = {
      status: response.status,
      headers: response.headers,
      body: Buffer.from(await response.arrayBuffer())
    };
    return sendResponse(res, result, method);
  }
}

/**
 * Get the upstream for a backend, creating it on first use. Routes for the same backend
 * share one instance.
 */
function createUpstream(name, options) {
  if (!upstreams.has(name)) {
    upstreams.set(name, new Upstream(name, options));
  }
  return upstreams.get(name);
}

module.exports = {
  createUpstream,
  buildPath,
  queryStringOf
};
