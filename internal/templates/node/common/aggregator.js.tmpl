/**
 * Parallel Aggregator Utility
 * Auto-generated by bffgen
 *
 * Handles parallel service calls in your own controllers, with a per-call timeout.
 * For routes that only combine backend responses, prefer "aggregates" in bffgen.config.json:
 * `bffgen generate` then writes them with per-backend timeouts, retries and circuit breakers.
 */

const logger = require('./logger');

class ParallelAggregator {
  /**
   * @param {Object} options
   * @param {number} options.timeout - Maximum time for each call in ms (default 30000)
   * @param {boolean} options.failFast - Reject as soon as one call fails, instead of
   *   resolving with every result (default false)
   */
  constructor(options = {}) {
    this.timeout = options.timeout || 30000;
    this.failFast = options.failFast || false;
  }

  /**
   * Execute multiple service calls in parallel
   * @param {Array<{name: string, fetch: Function}>} serviceCalls - Array of service call definitions
   * @returns {Promise<Array<{service: string, data: any, error: string|null, success: boolean}>>}
   *   One result per call, in order. With failFast, rejects with the first error instead.
   */
  async fetchParallel(serviceCalls) {
    const calls = serviceCalls.map(call => this.withTimeout(call));

    if (this.failFast) {
      const data = await Promise.all(calls);
      return data.map((value, i) => ({ service: serviceCalls[i].name, data: value, error: null, success: true }));
    }

    const results = await Promise.allSettled(calls);
    return results.map((result, i) => {
      if (result.status === 'fulfilled') {
        return { service: serviceCalls[i].name, data: result.value, error: null, success: true };
      }
      logger.warn(`Service ${serviceCalls[i].name} failed: ${result.reason?.message}`);
      return { service: serviceCalls[i].name, data: null, error: result.reason?.message || 'Unknown error', success: false };
    });
  }

  /**
   * Execute service calls in waterfall (sequential with dependency)
   * @param {Array<{name: string, fetch: Function}>} serviceCalls - Array of service call definitions
   * @returns {Promise<Array>}
   */
  async fetchWaterfall(serviceCalls) {
    const results = [];
    for (const call of serviceCalls) {
      try {
        const result = await call.fetch(results);
        results.push({ service: call.name, data: result, error: null, success: true });
      } catch (error) {
        logger.error(`Waterfall execution failed at ${call.name}:`, error);
        results.push({ service: call.name, data: null, error: error.message, success: false });
        break; // Stop waterfall on first failure
      }
    }
    return results;
  }

  /**
   * Run one call, rejecting if it takes longer than the timeout. The timer is always cleared,
   * so finished calls don't keep timers (and the process) alive.
   * @param {Object} call - { name, fetch }
   * @returns {Promise<any>}
   */
  async withTimeout(call) {
    let timer;
    const timeout = new Promise((_, reject) => {
      timer = setTimeout(() => reject(new Error(`${call.name} timed out after ${this.timeout}ms`)), this.timeout);
    });
    try {
      return await Promise.race([call.fetch(), timeout]);
    } finally {
      clearTimeout(timer);
    }
  }
}

module.exports = ParallelAggregator;
