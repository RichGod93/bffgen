/**
 * HTTP client for backend services
 * Managed by bffgen (bffgen:runtime 1). `bffgen generate` replaces this file when
 * bffgen ships a newer version and keeps your previous copy as httpClient.js.bak.
 *
 * - Each attempt has its own timeout, covering the response body as well as the headers.
 * - Only idempotent methods (GET, HEAD, OPTIONS) are retried, with exponential backoff,
 *   after a timeout, a connection failure or a 5xx response.
 * - Failures surface as UpstreamError with one of these codes:
 *     UPSTREAM_TIMEOUT      the backend did not answer in time
 *     UPSTREAM_UNAVAILABLE  the backend could not be reached (connection refused, DNS, reset)
 *     UPSTREAM_ERROR        the backend answered with a 5xx status
 */

const logger = require('../utils/logger');

const RETRYABLE_METHODS = new Set(['GET', 'HEAD', 'OPTIONS']);

// HTTP status the BFF answers with for each failure; also set as error.statusCode so the
// Express and Fastify error handlers respond correctly when a controller passes the error on
const STATUS_BY_CODE = {
  UPSTREAM_TIMEOUT: 504,
  UPSTREAM_UNAVAILABLE: 503,
  UPSTREAM_ERROR: 502
};

class UpstreamError extends Error {
  /**
   * @param {string} code - UPSTREAM_TIMEOUT | UPSTREAM_UNAVAILABLE | UPSTREAM_ERROR
   * @param {string} message
   * @param {Object} details - { service, upstreamStatus, cause }
   */
  constructor(code, message, { service, upstreamStatus, cause } = {}) {
    super(message, { cause });
    this.name = 'UpstreamError';
    this.code = code;
    this.service = service;
    this.upstreamStatus = upstreamStatus;
    this.statusCode = STATUS_BY_CODE[code];
  }
}

/**
 * Thrown by request() and the get/post/... helpers when the backend answers with a 4xx status.
 * `status` and `body` are the backend's.
 */
class HttpError extends Error {
  constructor(status, body, service) {
    super(`HTTP ${status}`);
    this.name = 'HttpError';
    this.status = status;
    this.body = body;
    this.service = service;
  }
}

class HttpClient {
  /**
   * @param {string} baseURL
   * @param {Object} options
   * @param {string} options.name - Backend name, used in errors and logs
   * @param {number} options.timeout - Per-attempt timeout in ms (default 10000)
   * @param {number} options.retries - Extra attempts for idempotent methods (default 2)
   * @param {number} options.retryDelay - Base backoff in ms, doubled per retry (default 100)
   */
  constructor(baseURL, options = {}) {
    this.baseURL = baseURL.replace(/\/+$/, '');
    this.name = options.name || this.baseURL;
    this.timeout = options.timeout ?? 10000;
    this.retries = options.retries ?? 2;
    this.retryDelay = options.retryDelay ?? 100;
  }

  /**
   * Send a request and return the raw response. Resolves for any status below 500;
   * throws UpstreamError for timeouts, connection failures and 5xx responses.
   * @param {string} path - Path (and query string) appended to the base URL
   * @param {Object} options - { method, headers, body }
   * @returns {Promise<{status: number, headers: Headers, body: Buffer}>}
   */
  async send(path, { method = 'GET', headers = {}, body } = {}) {
    const url = `${this.baseURL}${path}`;
    const attempts = RETRYABLE_METHODS.has(method) ? this.retries + 1 : 1;

    for (let attempt = 1; ; attempt++) {
      let error;
      try {
        const response = await fetch(url, { method, headers, body, signal: AbortSignal.timeout(this.timeout) });
        // Read the body under the same timeout
        const result = {
          status: response.status,
          headers: response.headers,
          body: Buffer.from(await response.arrayBuffer())
        };
        if (result.status < 500) {
          return result;
        }
        error = new UpstreamError('UPSTREAM_ERROR', `${this.name} returned ${result.status}`, {
          service: this.name,
          upstreamStatus: result.status
        });
      } catch (cause) {
        error = cause.name === 'TimeoutError'
          ? new UpstreamError('UPSTREAM_TIMEOUT', `${this.name} did not respond within ${this.timeout} ms`, { service: this.name, cause })
          : new UpstreamError('UPSTREAM_UNAVAILABLE', `${this.name} is unreachable`, { service: this.name, cause });
      }

      if (attempt >= attempts) {
        throw error;
      }
      logger.warn(`${method} ${url} failed (${error.code}), retrying (${attempt}/${attempts - 1})`);
      await this.delay(this.retryDelay * 2 ** (attempt - 1));
    }
  }

  /**
   * Make a request and return the parsed body (JSON, or text for other content types).
   * Throws HttpError for 4xx responses and UpstreamError for failures (see send()).
   */
  async request(path, options = {}) {
    const headers = { ...options.headers };
    if (options.body !== undefined && !Object.keys(headers).some(h => h.toLowerCase() === 'content-type')) {
      headers['Content-Type'] = 'application/json';
    }

    const { status, headers: responseHeaders, body } = await this.send(path, { ...options, headers });
    const contentType = responseHeaders.get('content-type') || '';
    const text = body.toString('utf8');
    const parsed = contentType.includes('application/json') && text ? JSON.parse(text) : text;

    if (status >= 400) {
      throw new HttpError(status, parsed, this.name);
    }
    return parsed;
  }

  async get(path, options = {}) {
    return this.request(path, { ...options, method: 'GET' });
  }

  async post(path, data, options = {}) {
    return this.request(path, { ...options, method: 'POST', body: data ? JSON.stringify(data) : undefined });
  }

  async put(path, data, options = {}) {
    return this.request(path, { ...options, method: 'PUT', body: data ? JSON.stringify(data) : undefined });
  }

  async patch(path, data, options = {}) {
    return this.request(path, { ...options, method: 'PATCH', body: data ? JSON.stringify(data) : undefined });
  }

  async delete(path, options = {}) {
    return this.request(path, { ...options, method: 'DELETE' });
  }

  delay(ms) {
    return new Promise(resolve => setTimeout(resolve, ms));
  }
}

module.exports = HttpClient;
module.exports.HttpClient = HttpClient;
module.exports.UpstreamError = UpstreamError;
module.exports.HttpError = HttpError;
