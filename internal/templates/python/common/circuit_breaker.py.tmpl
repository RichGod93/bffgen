"""
Circuit breaker for resilient service calls
Managed by bffgen (bffgen:runtime 1). `bffgen generate` replaces this file when
bffgen ships a newer version and keeps your previous copy as circuit_breaker.py.bak.

Stops calling a backend that keeps failing, so requests fail fast instead of piling up.
  CLOSED     calls pass through; failure_threshold consecutive failures open the circuit
  OPEN       calls are rejected with CircuitOpenError until `timeout` seconds have passed
  HALF_OPEN  one trial call is let through: success closes the circuit, failure reopens it

Usage:
    breaker = CircuitBreaker(failure_threshold=5, timeout=30, name="inventory")
    result = await breaker.call(my_async_function, arg1, arg2)
"""

import logging
import time
from enum import Enum
from typing import Any, Callable, Optional

logger = logging.getLogger(__name__)


class CircuitState(Enum):
    """Circuit breaker states"""

    CLOSED = "closed"  # Normal operation
    OPEN = "open"  # Failing, reject requests
    HALF_OPEN = "half_open"  # Testing if service recovered


class CircuitBreakerError(Exception):
    """Raised when circuit breaker is open"""


class CircuitOpenError(CircuitBreakerError):
    """Raised instead of calling the backend while the circuit is open"""

    code = "CIRCUIT_OPEN"
    status_code = 503

    def __init__(self, name: str, retry_after: float):
        super().__init__(f"Circuit breaker for {name} is open")
        self.message = str(self)
        self.service = name
        self.retry_after = retry_after  # seconds until the next trial request


def _default_is_failure(error: BaseException) -> bool:
    """Client errors (4xx) mean the backend is up and answering, so they don't count"""
    status = getattr(error, "status", None)
    return not (isinstance(status, int) and 400 <= status < 500)


class CircuitBreaker:
    """
    Circuit breaker for protecting against cascading failures

    Args:
        failure_threshold: Consecutive failures that open the circuit (default 5)
        timeout: Seconds the circuit stays open before a trial request (default 30)
        expected_exception: Exception type that is monitored; others pass through untouched
        name: Name used in logs and errors
        is_failure: Optional (error) -> bool, whether an error counts as a failure
    """

    def __init__(
        self,
        failure_threshold: int = 5,
        timeout: float = 30,
        expected_exception: type = Exception,
        name: str = "backend",
        is_failure: Optional[Callable[[BaseException], bool]] = None,
    ):
        self.failure_threshold = failure_threshold
        self.timeout = timeout
        self.expected_exception = expected_exception
        self.name = name
        self.is_failure = is_failure or _default_is_failure

        self.state = CircuitState.CLOSED
        self.failure_count = 0
        self.opened_at: Optional[float] = None
        self._trial_in_flight = False

    async def call(self, func: Callable, *args: Any, **kwargs: Any) -> Any:
        """
        Execute an async function with circuit breaker protection

        Raises:
            CircuitOpenError: If the circuit is open (a CircuitBreakerError)
        """
        if not self._allow_request():
            raise CircuitOpenError(self.name, self._retry_after())

        trial = self.state == CircuitState.HALF_OPEN
        try:
            result = await func(*args, **kwargs)
        except self.expected_exception as error:
            if self.is_failure(error):
                self._on_failure()
            else:
                self._on_success()
            raise
        else:
            self._on_success()
            return result
        finally:
            if trial:
                self._trial_in_flight = False

    def _allow_request(self) -> bool:
        if self.state == CircuitState.CLOSED:
            return True
        if self.state == CircuitState.OPEN:
            if self._retry_after() > 0:
                return False
            self.state = CircuitState.HALF_OPEN
            logger.info(f"Circuit breaker for {self.name} HALF_OPEN, sending a trial request")
        if self._trial_in_flight:
            return False
        self._trial_in_flight = True
        return True

    def _retry_after(self) -> float:
        if self.opened_at is None:
            return 0
        return max(0.0, self.opened_at + self.timeout - time.monotonic())

    def _on_success(self) -> None:
        if self.state == CircuitState.HALF_OPEN:
            logger.info(f"Circuit breaker for {self.name} CLOSED after successful trial")
        self.failure_count = 0
        self.state = CircuitState.CLOSED

    def _on_failure(self) -> None:
        self.failure_count += 1
        if self.state == CircuitState.HALF_OPEN or self.failure_count >= self.failure_threshold:
            self.state = CircuitState.OPEN
            self.opened_at = time.monotonic()
            logger.error(
                f"Circuit breaker for {self.name} OPEN after {self.failure_count} consecutive failures, "
                f"retrying in {self.timeout:g} s"
            )

    def get_state(self) -> dict:
        """Current state, for health endpoints"""
        return {
            "name": self.name,
            "state": self.state.value,
            "failures": self.failure_count,
            "retry_after": round(self._retry_after(), 3) if self.state == CircuitState.OPEN else None,
        }

    def reset(self) -> None:
        """Manually reset circuit breaker"""
        self.failure_count = 0
        self.opened_at = None
        self.state = CircuitState.CLOSED
        self._trial_in_flight = False
        logger.info(f"Circuit breaker for {self.name} manually reset")
