[tool.poetry]
name = "{{.ProjectName}}"
version = "1.0.0"
description = "Backend-for-Frontend service generated by bffgen"
authors = ["Your Name <you@example.com>"]
readme = "README.md"

[tool.poetry.dependencies]
python = "^3.10"
fastapi = "{{GetVersion "fastapi"}}"
uvicorn = {extras = ["standard"], version = "{{GetVersion "uvicorn"}}"}
starlette = "{{GetVersion "starlette"}}"
pydantic = "{{GetVersion "pydantic"}}"
pydantic-settings = "{{GetVersion "pydantic-settings"}}"
pyjwt = "{{GetVersion "pyjwt"}}"
python-multipart = "{{GetVersion "python-multipart"}}"
slowapi = "{{GetVersion "slowapi"}}"
httpx = "{{GetVersion "httpx"}}"
redis = "{{GetVersion "redis"}}"
python-dotenv = "{{GetVersion "python-dotenv"}}"

[tool.poetry.group.dev.dependencies]
pytest = "{{GetVersion "pytest"}}"
pytest-asyncio = "{{GetVersion "pytest-asyncio"}}"
pytest-cov = "{{GetVersion "pytest-cov"}}"
black = "{{GetVersion "black"}}"
ruff = "{{GetVersion "ruff"}}"
mypy = "{{GetVersion "mypy"}}"

[build-system]
requires = ["poetry-core"]
build-backend = "poetry.core.masonry.api"

[tool.black]
line-length = 100
target-version = ['py310', 'py311', 'py312', 'py313']

# Ruff is configured in ruff.toml

[tool.mypy]
python_version = "3.10"
warn_return_any = true
warn_unused_configs = true
disallow_untyped_defs = true

[tool.pytest.ini_options]
minversion = "7.0"
addopts = "-ra -q --cov=. --cov-report=term-missing"
testpaths = ["tests"]
asyncio_mode = "auto"

