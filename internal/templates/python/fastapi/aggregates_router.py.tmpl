"""
Aggregate routes (FastAPI)
Generated by bffgen from the "aggregates" in bffgen.config.py.json. `bffgen generate` overwrites this file.

Each route calls its sources in parallel and answers {"data", "sources"}; a failed source that
is not required leaves its data null. See aggregate() in utils/upstream.py.
"""

from fastapi import APIRouter, {{if or .AnyAuth .AnyRoles}}Depends, {{end}}Request, Response
{{if .AnyAuth}}
from middleware.auth import require_authentication
{{- end}}
{{- if .AnyRoles}}
from utils.authorize import require_roles
{{- end}}
from utils.upstream import Source, aggregate, create_upstream

router = APIRouter(tags=["aggregates"])
{{- range .Backends}}
{{.Var}} = create_upstream(
    {{printf "%q" .ServiceName}},
    env_key={{printf "%q" .EnvKey}},
    base_url={{printf "%q" .BaseURL}},
    timeout={{.Timeout}},
    retries={{.Retries}},
    circuit_breaker={"enabled": {{if .BreakerEnabled}}True{{else}}False{{end}}, "failureThreshold": {{.FailureThreshold}}, "resetTimeout": {{.ResetTimeout}}},
)
{{- end}}
{{- range .Aggregates}}


# GET {{.Path}}{{with .Name}} ({{.}}){{end}}
@router.api_route(
    {{printf "%q" .Path}},
    methods=["GET", "HEAD"],
{{- if .Roles}}
    dependencies=[Depends(require_roles({{.RolesArgs}}))],
{{- else if .RequiresAuth}}
    dependencies=[Depends(require_authentication)],
{{- end}}
)
async def {{.HandlerName}}(request: Request{{range .Params}}, {{.}}: str{{end}}) -> Response:
    return await aggregate(
        request,
        [
{{- range .Sources}}
            Source({{printf "%q" .As}}, {{.Var}}, {{printf "%q" .Path}}{{if .Required}}, required=True{{end}}),
{{- end}}
        ],
    )
{{- end}}
