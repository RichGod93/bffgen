import logging
import secrets
from typing import ClassVar, List, Union

from pydantic import field_validator, model_validator
from pydantic_settings import BaseSettings, SettingsConfigDict

logger = logging.getLogger(__name__)

# Secrets bffgen has shipped as defaults or in generated .env files
PLACEHOLDER_SECRETS = {
    "your-secret-key-change-in-production",
    "your-secret-key-change-in-production-use-min-32-chars",
    "change-this-secret-in-production-use-at-least-32-characters",
    "test-secret-key-do-not-use-in-production",
}
MIN_PRODUCTION_SECRET_LENGTH = 32  # RFC 7518 3.2: an HS256 key is at least 256 bits


class Settings(BaseSettings):
    """Application settings loaded from environment variables"""
    
    # Server Configuration
    HOST: str = "0.0.0.0"
    PORT: int = 8080
    ENVIRONMENT: str = "development"
    LOG_LEVEL: str = "INFO"
    
    # CORS Configuration
    CORS_ORIGINS: Union[List[str], str] = ["http://localhost:3000", "http://localhost:8080"]
    
    @field_validator('CORS_ORIGINS', mode='before')
    @classmethod
    def parse_cors_origins(cls, v):
        """Parse CORS_ORIGINS from comma-separated string or list"""
        if isinstance(v, str):
            return [origin.strip() for origin in v.split(',')]
        return v
    
    # JWT Configuration. JWT_SECRET: required when ENVIRONMENT=production (at least 32
    # characters, not a bffgen placeholder), else the app refuses to start. Elsewhere an
    # unset secret becomes a random one for this process (tokens stop working on restart).
    JWT_SECRET: str = ""
    JWT_ALGORITHM: ClassVar[str] = "HS256"  # tokens with any other algorithm are rejected
    JWT_EXPIRATION_MINUTES: int = 30
    
    # Rate Limiting
    RATE_LIMIT_ENABLED: bool = True
    RATE_LIMIT_PER_MINUTE: int = 60
    
    # Redis Configuration
    REDIS_HOST: str = "localhost"
    REDIS_PORT: int = 6379
    REDIS_DB: int = 0
    REDIS_PASSWORD: str = ""
    REDIS_ENABLED: bool = False
    
    # .env may also hold settings read elsewhere, such as backend URLs (USERS_URL=...),
    # so unknown keys are ignored rather than rejected
    model_config = SettingsConfigDict(
        env_file=".env",
        env_file_encoding="utf-8",
        case_sensitive=True,
        extra="ignore",
    )
    
    @model_validator(mode="after")
    def resolve_jwt_secret(self):
        """Refuse a missing or weak JWT_SECRET in production; use a random one elsewhere"""
        if self.ENVIRONMENT == "production":
            if not self.JWT_SECRET:
                raise ValueError("JWT_SECRET must be set when ENVIRONMENT=production")
            if self.JWT_SECRET in PLACEHOLDER_SECRETS:
                raise ValueError("JWT_SECRET is a bffgen placeholder; set a random secret, e.g. `openssl rand -base64 48`")
            if len(self.JWT_SECRET) < MIN_PRODUCTION_SECRET_LENGTH:
                raise ValueError(f"JWT_SECRET must be at least {MIN_PRODUCTION_SECRET_LENGTH} characters when ENVIRONMENT=production")
        elif not self.JWT_SECRET:
            logger.warning("JWT_SECRET is not set: using a random secret for this process. Tokens stop working on restart.")
            self.JWT_SECRET = secrets.token_urlsafe(48)
        return self

    @property
    def redis_url(self) -> str:
        """Generate Redis connection URL"""
        if self.REDIS_PASSWORD:
            return f"redis://:{self.REDIS_PASSWORD}@{self.REDIS_HOST}:{self.REDIS_PORT}/{self.REDIS_DB}"
        return f"redis://{self.REDIS_HOST}:{self.REDIS_PORT}/{self.REDIS_DB}"


# Global settings instance
settings = Settings()

